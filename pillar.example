# -*- coding: utf-8 -*-
# vim: ft=yaml
---
incus:
  enable: true

  # Repository configuration (Zabbly)
  repo:
    enable: true
    channel: stable

  # Package configuration
  pkg:
    name: incus
    deps:
      - python3-cryptography
      - qemu-kvm
      - lxcfs

  # Service configuration
  service:
    name: incus
    enable: true

  # LXCFS configuration
  global:
    lxcfs:
      enable: true
      modules:
        loadavg: true
        cfs: true
        memory: true
        cpuset: true
        sysinfo: true
        pidfd: true

  # API client / TLS configuration
  # Applied separately via: salt '<minion>' state.apply incus.tls
  api_client:
    enabled: false
    generate_storage:
      cert: /etc/salt/pki/incus/client.crt
      key: /etc/salt/pki/incus/client.key
    import_storage:
      cert: /etc/salt/pki/incus/client.crt
      key: /etc/salt/pki/incus/client.key
    generate:
      cn: salt-cloud
      days: 3650

  # Server settings (bulk)
  server_settings:
    config:
      core.https_address: "[::]:8443"
      images.auto_update_cached: "true"
      images.auto_update_interval: "12"

  # Server settings (individual)
  # server_settings_individual:
  #   https_api:
  #     ensure: present
  #     key: core.https_address
  #     value: "[::]:8443"

  # Images
  images:
    ubuntu2204:
      source:
        server: https://images.linuxcontainers.org
        alias: ubuntu/22.04
        protocol: simplestreams
      auto_update: true
      public: false

  # Storage pools
  storage_pools:
    default:
      driver: dir
      description: Default storage pool

  # Storage volumes
  # storage_volumes:
  #   my-volume:
  #     pool: default
  #     config:
  #       size: 10GiB

  # Networks
  networks:
    incusbr0:
      network_type: bridge
      config:
        ipv4.address: 10.0.0.1/24
        ipv4.nat: "true"
        ipv6.address: none

  # Profiles
  profiles:
    default:
      config:
        limits.cpu: "2"
        limits.memory: 2GiB
      devices:
        root:
          type: disk
          path: /
          pool: default

  # Instances
  instances:
    web-container:
      instance_type: container
      source:
        type: image
        alias: ubuntu/22.04
      config:
        limits.cpu: "2"
        limits.memory: 2GiB
      profiles:
        - default
      ephemeral: false
      started: true

  # Instance snapshots
  # instance_snapshots:
  #   web-before-update:
  #     instance: web-container
  #     name: before-system-update
  #     stateful: false
  #     description: Snapshot before OS update
